# Copy this file to .env and fill in your actual values

# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here

# Discord OAuth2 Configuration (for user dashboard)
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:5173/auth/callback
FRONTEND_URL=http://localhost:5173

# Top.gg Configuration
TOPGG_TOKEN=your_topgg_token_here

# Mistral AI Configuration
MISTRAL_API_KEY=your_mistral_api_key_here

# [Deprecated] Google Gemini (TTS) Configuration
# Kept for compatibility; no longer used for TTS
GEMINI_API_KEY=your_gemini_api_key_here

# Mycroft Mimic3 (TTS) Configuration
# Run a Mimic3 server locally or via Docker and point this URL to it.
# Example Docker: docker run -p 59125:59125 synesthesiam/mimic3-server
MIMIC3_URL=http://localhost:59125

# Voice defaults
# Use the format lang/voice[-tier] (examples: en_US/amy-medium, ko_KR/kss)
MIMIC3_DEFAULT_VOICE=en_US/amy-medium
MIMIC3_VOICE_EN=en_US/amy-medium
MIMIC3_VOICE_KO=ko_KR/kss

# Playback volume multiplier for voice output (0.1–5.0)
TTS_VOLUME=1.6

# Database Configuration
MONGODB_URI=your_mongodb_connection_string_here

# Admin Panel Configuration (Optional)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# Admin Notifications (Optional)
# When a premium request is created, the bot will notify this user (DM) and/or post to the specified channel
ADMIN_NOTIFY_USER_ID=your_discord_user_id_here
ADMIN_NOTIFY_GUILD_ID=your_admin_guild_id_here
ADMIN_NOTIFY_CHANNEL_ID=your_admin_channel_id_here

# Environment
NODE_ENV=production
PORT=3000

# Render Deployment URL (Optional - will be provided by Render)
RENDER_EXTERNAL_URL=https://your-app-name.onrender.com
