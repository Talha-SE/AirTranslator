# Copy this file to .env and fill in your actual values

# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here

# Top.gg Configuration
TOPGG_TOKEN=your_topgg_token_here

# Mistral AI Configuration
MISTRAL_API_KEY=your_mistral_api_key_here

# Groq AI Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_2=your_optional_second_groq_api_key_here

# Google Gemini (TTS) Configuration
GEMINI_API_KEY=AIzaSyBynoq3mpZ1n2UN2gmrNTIfEpdArIVKRgI

# Database Configuration
MONGODB_URI=your_mongodb_connection_string_here

# Admin Panel Configuration (Optional)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# Environment
NODE_ENV=production
PORT=3000

# Render Deployment URL (Optional - will be provided by Render)
RENDER_EXTERNAL_URL=https://your-app-name.onrender.com
