# Copy this file to .env and fill in your actual values

# Mistral AI API Key - Get from https://mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# MongoDB Atlas Connection String - Get from https://cloud.mongodb.com/
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Discord Bot Token - Get from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Client ID - Get from https://discord.com/developers/applications
CLIENT_ID=your_discord_client_id_here

# Admin Panel Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AirTranslator2024!

# Environment
NODE_ENV=development
