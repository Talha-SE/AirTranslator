# Copy this file to .env and fill in your actual values

# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# Dashboard API Configuration
BOT_API_SECRET=generate_a_secure_random_string_here
BOT_API_PORT=3001

# Frontend/Dashboard URLs - Update these for production deployment
# For local development:
# FRONTEND_URL=http://localhost:5173
# DASHBOARD_REDIRECT_URI=http://localhost:3001/api/auth/callback

# For production (replace with your actual domain):
FRONTEND_URL=https://airtranslator.brevios.com
DASHBOARD_REDIRECT_URI=https://airtranslator-server.duckdns.org:3001/api/auth/callback

# Top.gg Configuration
TOPGG_TOKEN=your_topgg_token_here

# Mistral AI Configuration
MISTRAL_API_KEY=your_mistral_api_key_here
# Optional: Additional API keys for load balancing (rotation)
# MISTRAL_API_KEY_2=your_second_mistral_api_key_here
# MISTRAL_API_KEY_3=your_third_mistral_api_key_here
# MISTRAL_API_KEY_4=...
# MISTRAL_API_KEY_5=...
# MISTRAL_API_KEY_6=...
# Optional: Separate key for language detection (falls back to MISTRAL_API_KEY)
# MISTRAL_DETECT_API_KEY=your_detection_key_here

# ─── Thinking / Reasoning Mode ───────────────────────────────────────────────
# Mistral's "thinking" mode is controlled via the `reasoning_effort` parameter.
# Valid values: "none" | "minimal" | "low" | "medium" | "high" | "xhigh"
# When set to anything other than "none", the model produces a thinking trace
# before the final answer, improving translation quality (context, nuance, tone).
# Note: Higher effort = more output tokens (thinking trace) + higher latency.
# Default: "high" for all translation paths.
MISTRAL_REASONING_EFFORT=high
# Reasoning effort for tone-understanding translations (emotion/sarcasm/elongation)
MISTRAL_REASONING_EFFORT_TONE=high
# Reasoning effort for batch multi-language translations
MISTRAL_REASONING_EFFORT_BATCH=high
# Set to "true" to log the actual thinking trace received from the API in the
# console (useful for debugging). When off/false, no thinking trace is logged.
# MISTRAL_THINKING_LOG=false

# Database Configuration
MONGODB_URI=your_mongodb_connection_string_here

# Admin Panel Configuration (Optional)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# Admin Notifications (Optional)
# When a premium request is created, the bot will notify this user (DM) and/or post to the specified channel
ADMIN_NOTIFY_USER_ID=your_discord_user_id_here
ADMIN_NOTIFY_GUILD_ID=your_admin_guild_id_here
ADMIN_NOTIFY_CHANNEL_ID=your_admin_channel_id_here

# Environment
NODE_ENV=production
PORT=3000
